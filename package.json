{
  "name": "copilot-google-connector",
  "version": "0.1.1",
  "private": true,
  "description": "Local, multi-account Gmail and Google Calendar MCP connector",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "google-connector": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:unit": "node --test dist/test/*.test.js",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "@simplewebauthn/server": "13.3.3",
    "google-auth-library": "11.0.2",
    "mailparser": "3.9.17",
    "nodemailer": "9.0.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "26.4.0",
    "@types/nodemailer": "^7.0.11",
    "typescript": "7.0.2"
  }
}
